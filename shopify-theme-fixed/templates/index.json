 a cleaner, more enjoyable atmosphere.\n    <\/p>\n\n    <ul class=\"jf-why__list\" role=\"list\">\n      <li>Hand-poured in New Hampshire using clean-burning soy wax for a smooth, even burn  \n  \n<\/li>\n      <li>Eco-friendly hemp wicks for a consistent, refined flame  \n  \n<\/li>\n      <li>Premium fragrance oils free from harsh additives<\/li>\n      <li>Virtually no soot, smoke, or residue  \n<\/li>\n      <li>Crafted to elevate your space and atmosphere<\/li>\n    <\/ul>\n\n    <h4 class=\"jf-why__closing\">\n      <strong>Better for your space. Better for the air you breathe.<\/strong>\n    <\/h4>\n\n    <div class=\"jf-why__pill\">\n      <span>Small Batch<\/span>\n      <span class=\"dot\">•<\/span>\n      <span>Clean Burn<\/span>\n      <span class=\"dot\">•<\/span>\n      <span>Crafted with Care<\/span>\n    <\/div>\n  <\/div>\n<\/section>\n\n<style>\n  \/* 1) Remove theme section padding\/container constraints *\/\n  .shopify-section:has(.jf-why){\n    padding: 0 !important;\n    margin: 0 !important;\n    max-width: 100% !important;\n  }\n\n  \/* 2) Force true full-bleed background *\/\n  .jf-why{\n    background:#EAE4DC;\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    padding: clamp(72px, 6vw, 96px) 0;\n  }\n\n  \/* 3) Keep content readable *\/\n  .jf-why__wrap{\n    max-width: 880px;\n    margin: 0 auto;\n    text-align: center;\n    padding: 0 24px; \/* mobile\/desktop side breathing room *\/\n  }\n\n  .jf-why__title{\n    margin:0;\n    font-weight:500;\n    letter-spacing:.02em;\n    line-height:1.15;\n    font-size: clamp(1.875rem, 2.6vw, 2.5rem);\n    color:#1F1F1F;\n  }\n\n  .jf-why__subtitle{\n    margin-top:12px;\n    font-size:clamp(15px,1.25vw,18px);\n    letter-spacing:.14em;\n    text-transform:uppercase;\n    color:#60605F;\n  }\n\n  .jf-why__divider{\n    width: min(120px, 28vw);\n    height: 1px;\n    margin: 18px auto 0;\n    background: linear-gradient(\n      90deg,\n      rgba(196,169,137,0) 0%,\n      rgba(196,169,137,1) 50%,\n      rgba(196,169,137,0) 100%\n    );\n  }\n\n  .jf-why__intro{\n    margin:24px auto 0;\n    max-width:720px;\n    font-size:clamp(16px,1.35vw,18px);\n    line-height:1.7;\n    color:#3E3A36;\n  }\n\n  .jf-why__list,\n  .jf-why__list li{\n    list-style:none !important;\n    margin:0;\n    padding:0;\n  }\n\n  .jf-why__list{\n    margin:28px auto 0;\n    max-width:720px;\n    display:grid;\n    gap:16px;\n  }\n\n  .jf-why__list li{\n    position:relative;\n    padding-left:22px;\n    text-align:left;\n    font-size:clamp(15px,1.25vw,18px);\n    line-height:1.7;\n    color:#3E3A36;\n  }\n\n  .jf-why__list li::before{\n    content:\"\";\n    width:6px;\n    height:6px;\n    background:#C4A989;\n    border-radius:50%;\n    position:absolute;\n    left:0;\n    top:11px;\n  }\n\n  .jf-why__closing{\n    margin:28px auto 0;\n  font-size:clamp(14px,1.1vw,16px);\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  color:#60605F;\n  }\n\n  .jf-why__pill{\n    margin:28px auto 0;\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    padding:14px 22px;\n    border:1px solid rgba(31,31,31,.14);\n    border-radius:999px;\n    background:rgba(255,255,255,.55);\n    color:#60605F;\n    font-size:13px;\n    letter-spacing:.16em;\n    text-transform:uppercase;\n    box-shadow:0 6px 18px rgba(0,0,0,0.06);\n  }\n\n  .jf-why__pill .dot{ opacity:.7; }\n\n  @media (max-width: 640px){\n    .jf-why__wrap{ padding: 0 20px; }\n    .jf-why__pill{\n      flex-wrap:wrap;\n      justify-content:center;\n      gap:8px;\n      padding:12px 16px;\n    }\n  }\n<\/style>","full_width":true,"show_section_divider":false,"padding_top":0,"padding_bottom":0,"full_width_mobile":true,"show_section_divider_mobile":false,"padding_top_mobile":0,"padding_bottom_mobile":0}},"slideshow_pe3XTi":{"type":"slideshow","blocks":{"slide_7gPELi":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/jf-candle-co-white-sage-lavender-12oz-double-wick-with-wax-melts-luxury-lifestyle.j