cing:.02em;\n  line-height:1.15;\n  font-size: clamp(1.875rem, 2.6vw, 2rem);\n  color:#1F1F1F;\n}\n\n\/* ===== DIVIDER ===== *\/\n.jf-intro__divider{\n  width:min(120px,28vw);\n  height:1px;\n  margin:18px auto 0;\n  background:linear-gradient(\n    90deg,\n    rgba(196,169,137,0) 0%,\n    rgba(196,169,137,1) 50%,\n    rgba(196,169,137,0) 100%\n  );\n}\n\n\/* ===== BODY TEXT ===== *\/\n.jf-intro__text{\n  margin:24px auto 0;\n  max-width:720px;\n  font-size:clamp(16px,1.35vw,18px);\n  line-height:1.75;\n  color:#3E3A36;\n}\n\n.jf-intro__text--second{\n  margin-top:18px;\n}\n\n\/* ===== VALUE PILL ===== *\/\n.jf-intro__pill{\n  margin:34px auto 0;\n  display:inline-flex;\n  align-items:center;\n  gap:14px;\n  padding:16px 22px;\n  border:1px solid rgba(31,31,31,.14);\n  border-radius:999px;\n  background:rgba(255,255,255,.65);\n  color:#60605F;\n  font-size:13px;\n  letter-spacing:.16em;\n  text-transform:uppercase;\nbox-shadow: 0 6px 18px rgba(0,0,0,0.06);\n}\n\n.jf-intro__pill .dot{\n  opacity:.7;\n}\n\n\/* ===== MOBILE ===== *\/\n@media (max-width:768px){\n  .jf-intro{\n    padding-top:72px;\n    padding-bottom:72px;\n  }\n\n  .jf-intro__pill{\n    flex-wrap:wrap;\n    justify-content:center;\n    gap:10px;\n    padding:14px 18px;\n  }\n}\n<\/style>","full_width":false,"show_section_divider":false,"padding_top":0,"padding_bottom":0,"full_width_mobile":false,"show_section_divider_mobile":false,"padding_top_mobile":0,"padding_bottom_mobile":0}},"e32885d8-0a8f-4c4f-8801-377d01cb7656":{"type":"featured-collection","blocks":{"collection_M67DjH":{"type":"collection","settings":{"collection":"summer-candle-scents","show_description":false,"description":"","number_of_lines_shown":"none","read_more_label":"Read more","see_less_label":"See less","show_vendor":false,"show_rating":false,"show_highlighted_features":true,"show_highlighted_attributes":true,"show_quickview":true,"show_promotion":false,"promotion_position":"left","card_link":"","open_new_window":false,"heading":"F